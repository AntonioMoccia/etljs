{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "etl-js": ["src/core/index.ts"],
      "etl-js/contracts": ["src/contracts/index.ts"],
      "etl-js/csv": ["src/csv/index.ts"],
      "etl-js/postgres": ["src/postgres/index.ts"],
      "etl-js/transforms": ["src/transforms/index.ts"],
      "etl-js/lookup": ["src/lookup/index.ts"],
      "etl-js/cli": ["src/cli/index.ts"],
      "@etl-js/testing": ["packages/testing/src/index.ts"]
    }
  },
  "include": [
    "src/**/*.ts",
    "test/**/*.ts",
    "tools/**/*.ts",
    "packages/testing/src/**/*.ts",
    "vitest.config.ts",
    "vitest.docs.config.ts"
  ]
}
