{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "etljs": ["src/core/index.ts"],
      "etljs/contracts": ["src/contracts/index.ts"],
      "etljs/csv-reader": ["src/csv-reader/index.ts"],
      "etljs/postgres-writer": ["src/postgres-writer/index.ts"],
      "etljs/transformers": ["src/transformers/index.ts"],
      "etljs/lookup-transformer": ["src/lookup-transformer/index.ts"],
      "etljs/cli": ["src/cli/index.ts"],
      "@etljs/testing": ["packages/testing/src/index.ts"]
    }
  },
  "include": [
    "src/**/*.ts",
    "test/**/*.ts",
    "tools/**/*.ts",
    "packages/testing/src/**/*.ts",
    "packages/testing/test/**/*.ts",
    "vitest.config.ts",
    "vitest.docs.config.ts"
  ]
}
